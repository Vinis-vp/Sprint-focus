<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SprintFocus.ViewModels"
        xmlns:ic="using:FluentIcons.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="560"
        x:Class="SprintFocus.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/sprintfocus.ico"
        Width="900" Height="560"
        MinWidth="640" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Title="SprintFocus">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="190,*">

        <!-- Menu lateral -->
        <Border Grid.Column="0" Classes="sidebar">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="SprintFocus" Classes="brand" />
                <ListBox ItemsSource="{Binding Pages}"
                         SelectedItem="{Binding SelectedPage}"
                         Classes="nav">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavItem">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <ic:SymbolIcon Symbol="{Binding Icon}" FontSize="18" />
                                <TextBlock Text="{Binding Title}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Página atual: o ViewLocator resolve TimerViewModel -> TimerView, etc.
             TransitioningContentControl faz um fade curto ao trocar de página. -->
        <TransitioningContentControl Grid.Column="1"
                                     Content="{Binding SelectedPage.Page}"
                                     Margin="40,32">
            <TransitioningContentControl.PageTransition>
                <CrossFade Duration="0:0:0.18" />
            </TransitioningContentControl.PageTransition>
        </TransitioningContentControl>
    </Grid>

</Window>
