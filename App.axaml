<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SprintFocus.App"
             xmlns:local="using:SprintFocus"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SidebarBrush" Color="#F3F4F6" />
                    <SolidColorBrush x:Key="CardBrush" Color="#F7F8FA" />
                    <SolidColorBrush x:Key="TrackBrush" Color="#E3E5EA" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SidebarBrush" Color="#191B20" />
                    <SolidColorBrush x:Key="CardBrush" Color="#22252B" />
                    <SolidColorBrush x:Key="TrackBrush" Color="#33363D" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="/Styles/Animations.axaml" />

        <!-- Menu lateral -->
        <Style Selector="Border.sidebar">
            <Setter Property="Background" Value="{DynamicResource SidebarBrush}" />
            <Setter Property="Padding" Value="12,24" />
        </Style>
        <Style Selector="TextBlock.brand">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="12,0,0,24" />
        </Style>
        <Style Selector="ListBox.nav">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <!-- Tipografia -->
        <Style Selector="TextBlock.h1">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Opacity" Value="0.6" />
        </Style>

        <!-- Cartões -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <!-- Barras de progresso finas -->
        <Style Selector="ProgressBar.thin">
            <Setter Property="Height" Value="6" />
            <Setter Property="MinHeight" Value="6" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="{DynamicResource TrackBrush}" />
        </Style>

        <!-- Seletor de categoria em "chips" -->
        <Style Selector="ListBox.chips">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.chips ListBoxItem">
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        </Style>
    </Application.Styles>
</Application>
